# Orchestrator Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8001

# LLM Provider Configuration (Self-hosted per ADR-001)
LLM_DEFAULT_PROVIDER=self_hosted
SELF_HOSTED_LLM_URL=http://localhost:8003
SELF_HOSTED_MODEL=llama-3.1-8b
SELF_HOSTED_TIMEOUT=30
SELF_HOSTED_MAX_TOKENS=2048
SELF_HOSTED_TEMPERATURE=0.7

# External Providers (Opt-in per ADR-001)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=ip_sakti

# Sparse Retrieval (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=ip_sakti

# Knowledge Graph (Neo4j - Phase 2)
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Logging
LOG_LEVEL=INFO
OTEL_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
